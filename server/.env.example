# Supabase — use the service role key on the server (NOT the anon/public key)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Google Maps Platform — enable Distance Matrix API in your Cloud Console
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Express server port
PORT=3001
